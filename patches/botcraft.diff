+        bool jump;
+        bool reached;
+    };
+
+    // Water keeps pushing between ticks: steer against sideways drift and keep swimming up on every tick.
+    inline Inputs Towards(const double dx, const double dy, const double dz,
+        const double vx, const double vz, const double yaw)
+    {
+        const double distance = std::hypot(dx, dz);
+        const double scale = distance > 0.2 ? 0.09 / distance : 0.0;
+        const double ax = (dx * scale - vx) * 12.0;
+        const double az = (dz * scale - vz) * 12.0;
+        const double radians = yaw * 0.017453292519943295;
+        const double cosine = std::cos(radians), sine = std::sin(radians);
+        return { std::clamp(az * cosine - ax * sine, -1.0, 1.0),
+            std::clamp(ax * cosine + az * sine, -1.0, 1.0),
+            dy >= -0.2, distance < 0.2 && dy >= -0.75 && dy <= 0.2 };
+    }
+}
