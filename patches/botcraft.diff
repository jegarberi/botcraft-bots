+    /// @brief A shared mutex where a waiting writer goes first: new readers wait while one is queued, unless their
+    /// thread already holds a read lock (a reader entering again would otherwise deadlock with that writer). With
+    /// 100 bots reading the shared world nonstop, the plain one kept the network threads (the writers) waiting
+    /// over a second per update, and the keep-alive answers queued behind them: the server dropped the bots
+    class WritePreferringMutex
+    {
+    public:
+        void lock() { ++writers_waiting; mutex.lock(); --writers_waiting; }
+        bool try_lock() { return mutex.try_lock(); }
+        void unlock() { mutex.unlock(); }
+        // A thread already reading this world reads again without touching the lock: a search holds it once and
+        // its millions of block reads cost nothing (one shared counter bounced between 30 cores was 63% of the CPU)
+        void lock_shared()
+        {
+            if (int* depth = Held())
+            {
+                ++*depth;
+                return;
+            }
+            if (reads_held == 0)
+            {
+                while (writers_waiting.load(std::memory_order_acquire) > 0)
+                {
+                    std::this_thread::yield();
+                }
+            }
+            mutex.lock_shared();
+            ++reads_held;
+            held.push_back({ this, 1 });
+        }
+        bool try_lock_shared()
+        {
+            if (int* depth = Held())
+            {
+                ++*depth;
+                return true;
+            }
+            if (!mutex.try_lock_shared()) return false;
+            ++reads_held;
+            held.push_back({ this, 1 });
+            return true;
+        }
+        void unlock_shared()
+        {
+            for (size_t i = 0; i < held.size(); ++i)
+            {
+                if (held[i].first == this && --held[i].second == 0)
+                {
+                    held.erase(held.begin() + i);
+                    --reads_held;
+                    mutex.unlock_shared();
+                    return;
+                }
+            }
+        }
+
+    private:
+        int* Held()
+        {
+            for (auto& [m, depth] : held) if (m == this) return &depth;
+            return nullptr;
+        }
+        std::shared_mutex mutex;
+        std::atomic<int> writers_waiting = 0;
+        // Read locks this thread holds, on any world (ponytail: counted across instances; a thread reading one
+        // world then another skips the wait on the second, never deadlocks)
+        static inline thread_local int reads_held = 0;
+        // Which of them, and how many times over
+        static inline thread_local std::vector<std::pair<const WritePreferringMutex*, int>> held;
+    };
+}
